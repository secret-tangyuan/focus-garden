# 专注学习站 · 本地 nginx 模板（由 scripts/build_wsl_test_env.sh 渲染）
# 模板里的 __XXX__ 全部来自 deploy/env/*.env，不在这里写死地址。

server {
    listen 80;
    listen [::]:80;
    server_name __FOCUS_HOST__;

    root __STAGE_DIR__/focus-garden;
    index index.html;

    gzip on;
    gzip_min_length 1k;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 统一身份接口：同源反代，站内精简登录直接调 /auth/login
    location ^~ /auth/ {
        proxy_pass __BACKEND_ORIGIN__/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|mjs|wasm|woff2?|ttf|otf|webp|svg|png|jpg|jpeg|gif|ico|json)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /serviceworker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }
}
