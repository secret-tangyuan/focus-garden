# 专注学习站 · 生产地址配置（样例）
# 复制成 prod.env 再填真实值；prod.env 不进仓库。

FOCUS_BASE_URL=https://example.com
FOCUS_HOST=example.com

# 身份服务（留空则不显示登录入口）
IDENTITY_BASE_URL=
IDENTITY_API_LOGIN=
IDENTITY_API_SESSION=
IDENTITY_API_RENEW=
IDENTITY_API_GARDEN=/auth/garden
IDENTITY_API_LOGOUT=
IDENTITY_PREFIX=/api-identity

# 身份服务后端（服务器本机）
BACKEND_ORIGIN=http://127.0.0.1:8080

# 站点根目录
SITE_ROOT=/var/www/focus-garden/dist

# TLS 证书
SSL_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/example.com/privkey.pem
