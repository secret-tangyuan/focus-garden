# 专注学习站 · 生产地址配置（样例）
# 复制成 prod.env 再填真实值；prod.env 不进仓库。

FOCUS_BASE_URL=https://focus.secret-tangyuan.com
FOCUS_HOST=focus.secret-tangyuan.com

# 统一身份中心（完整登录页入口）
AUTH_BASE_URL=https://auth.secret-tangyuan.com

# 统一身份后端（服务器本机）
BACKEND_ORIGIN=http://127.0.0.1:8080

# nginx 里反代身份接口的前缀
AUTH_PROXY_PREFIX=/auth

# 站点根目录
SITE_ROOT=/var/www/focus-garden/dist

# TLS 证书
SSL_CERT=/etc/letsencrypt/live/focus.secret-tangyuan.com/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/focus.secret-tangyuan.com/privkey.pem
