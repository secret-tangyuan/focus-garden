# 专注学习站 · 本地测试环境地址配置（唯一来源）
# 改地址只改这个文件，不要改脚本 / 模板 / 页面里的字面量。

FOCUS_BASE_URL=http://focus.secret-tangyuan.test/
FOCUS_HOST=focus.secret-tangyuan.test

# 统一身份后端（nginx 同源反代 /auth/ 用）
BACKEND_ORIGIN=http://127.0.0.1:8080

# 统一身份中心（完整登录页 / 注册 的入口）
AUTH_BASE_URL=http://auth.secret-tangyuan.test

SRC_DIR=/srv/src
STAGE_DIR=/srv/stage
WIN_ROOT=/mnt/c/Users/Administrator/Desktop/works/web_work
