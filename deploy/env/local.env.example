# 专注学习站 · 本地环境地址配置（样例）
# 复制成 local.env 再按本机情况改；local.env 不进仓库。

# 本站
FOCUS_BASE_URL=http://localhost:5174
FOCUS_HOST=localhost

# 身份服务（可留空：留空则不显示登录入口）
IDENTITY_BASE_URL=
IDENTITY_API_LOGIN=
IDENTITY_API_SESSION=
IDENTITY_API_RENEW=
IDENTITY_API_GARDEN=/auth/garden
IDENTITY_API_LOGOUT=
IDENTITY_PREFIX=/api-identity

# 身份服务后端（nginx 反代用）
BACKEND_ORIGIN=http://127.0.0.1:8080

# 目录
SRC_DIR=/srv/app-src
STAGE_DIR=/srv/app-dist
WIN_ROOT=/mnt/c/Users/Administrator/Desktop/works/web_work
